{
  "title": [
    {
      "i": 0,
      "text": "森林里，住着一只跑得飞快的兔子，和一只慢慢吞吞的乌龟。",
      "dur": 5.782
    },
    {
      "i": 1,
      "text": "有一天，他们要比一比，到底谁跑得更快。",
      "dur": 4.598
    }
  ],
  "meet": [
    {
      "i": 0,
      "text": "兔子在草地上蹦来蹦去，看见乌龟正一步一步地爬。",
      "dur": 5.108
    },
    {
      "i": 1,
      "text": "兔子哈哈大笑：乌龟，你走得这么慢，也敢和我赛跑吗？",
      "dur": 6.2
    },
    {
      "i": 2,
      "text": "乌龟抬起头，不紧不慢地说：",
      "dur": 2.694
    },
    {
      "i": 3,
      "text": "比一比，不就知道了？",
      "dur": 2.125
    }
  ],
  "challenge": [
    {
      "i": 0,
      "text": "这话传遍了森林，小动物们都跑来围观。",
      "dur": 4.029
    },
    {
      "i": 1,
      "text": "猫头鹰裁判站在老树桩上，推了推眼镜：",
      "dur": 3.924
    },
    {
      "i": 2,
      "text": "从森林这头，跑到山脚下的终点线，谁也不许抄近路。",
      "dur": 5.259
    },
    {
      "i": 3,
      "text": "准备好了吗？",
      "dur": 1.138
    }
  ],
  "start": [
    {
      "i": 0,
      "text": "各就各位——",
      "dur": 1.37
    },
    {
      "i": 1,
      "text": "预备——跑！",
      "dur": 1.463
    },
    {
      "i": 2,
      "text": "兔子像一阵风，嗖地冲了出去。",
      "dur": 3.123
    }
  ],
  "sprint": [
    {
      "i": 0,
      "text": "兔子跑得真快呀，一转眼就没了影子。",
      "dur": 3.692
    },
    {
      "i": 1,
      "text": "乌龟呢？他一步一步，稳稳地往前爬。",
      "dur": 3.785
    },
    {
      "i": 2,
      "text": "兔子回头一看，乌龟还离得远呢。",
      "dur": 3.123
    }
  ],
  "taunt": [
    {
      "i": 0,
      "text": "兔子心想：我跑得这么快，就算睡一觉，也来得及。",
      "dur": 4.969
    },
    {
      "i": 1,
      "text": "他往草地上一躺，啃起了胡萝卜。",
      "dur": 3.216
    },
    {
      "i": 2,
      "text": "乌龟还早着呢，我先歇一会儿。",
      "dur": 2.694
    }
  ],
  "nap": [
    {
      "i": 0,
      "text": "太阳暖洋洋的，风轻轻的。",
      "dur": 3.46
    },
    {
      "i": 1,
      "text": "兔子的眼皮越来越重，越来越重……",
      "dur": 3.123
    },
    {
      "i": 2,
      "text": "呼——呼——他睡着了。",
      "dur": 3.599
    },
    {
      "i": 3,
      "text": "就在这时，乌龟一步一步，从他身边爬了过去。",
      "dur": 4.923
    }
  ],
  "pass": [
    {
      "i": 0,
      "text": "乌龟没有停下来，也没有回头。",
      "dur": 3.03
    },
    {
      "i": 1,
      "text": "一步，又一步。汗珠掉在土里，他也不歇。",
      "dur": 4.783
    },
    {
      "i": 2,
      "text": "小动物们屏住呼吸，悄悄地为他加油。",
      "dur": 3.924
    }
  ],
  "wake": [
    {
      "i": 0,
      "text": "兔子一觉醒来，伸了个懒腰。",
      "dur": 2.891
    },
    {
      "i": 1,
      "text": "他往山脚下一看——乌龟已经快到终点了！",
      "dur": 4.075
    },
    {
      "i": 2,
      "text": "兔子吓了一跳，撒开腿就追。",
      "dur": 3.123
    }
  ],
  "chase": [
    {
      "i": 0,
      "text": "风在耳边呼呼地响，兔子跑得比刚才还快。",
      "dur": 4.447
    },
    {
      "i": 1,
      "text": "乌龟听到了身后的脚步声，咬紧牙，继续往前爬。",
      "dur": 4.783
    },
    {
      "i": 2,
      "text": "终点就在前面，红丝带在风里飘呀飘。",
      "dur": 4.261
    }
  ],
  "finish": [
    {
      "i": 0,
      "text": "乌龟伸出脖子，向前一扑——",
      "dur": 3.216
    },
    {
      "i": 1,
      "text": "红丝带落了下来！",
      "dur": 1.892
    },
    {
      "i": 2,
      "text": "乌龟先到了！森林里响起一片欢呼。",
      "dur": 4.261
    },
    {
      "i": 3,
      "text": "兔子气喘吁吁地赶到，低下了头。",
      "dur": 3.355
    }
  ],
  "moral": [
    {
      "i": 0,
      "text": "兔子小声说：我跑得比你快，可是我输了。",
      "dur": 4.598
    },
    {
      "i": 1,
      "text": "乌龟笑着说：你只是跑得快，我是一直没有停。",
      "dur": 4.69
    },
    {
      "i": 2,
      "text": "兔子点点头：下次，我一定跑完全程，再休息。",
      "dur": 5.0
    },
    {
      "i": 3,
      "text": "小朋友，跑得快，不如走得稳；",
      "dur": 2.984
    },
    {
      "i": 4,
      "text": "不怕慢，只怕站。坚持下去，就会到达终点。",
      "dur": 5.352
    }
  ],
  "finale": [
    {
      "i": 0,
      "text": "从那以后，兔子和乌龟成了好朋友。",
      "dur": 3.216
    },
    {
      "i": 1,
      "text": "他们常常一起，在山坡上看夕阳。",
      "dur": 3.785
    }
  ]
}